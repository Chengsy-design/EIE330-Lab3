#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/v2009.vpi";
S_0xb40bbe92e500 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0xb40bbe92e690 .scope module, "tb_pll" "tb_pll" 3 12;
 .timescale -9 -9;
v0xb40bbe9bcfd0_0 .var/i "errors", 31 0;
v0xb40bbe9bd0b0_0 .var "high_time", 63 0;
v0xb40bbe9bd190_0 .var "period", 63 0;
v0xb40bbe9bd250_0 .var "sys_clk", 0 0;
v0xb40bbe9bd320_0 .var "sys_rst_n", 0 0;
v0xb40bbe9bd410_0 .var "t_fall", 63 0;
v0xb40bbe9bd4b0_0 .var "t_next", 63 0;
v0xb40bbe9bd590_0 .var "t_rise", 63 0;
v0xb40bbe9bd670_0 .net "vga_clk", 0 0, v0xb40bbe9bceb0_0;  1 drivers
S_0xb40bbe9584b0 .scope task, "check_period" "check_period" 3 31, 3 31 0, S_0xb40bbe92e690;
 .timescale -9 -9;
v0xb40bbe954290_0 .var "exp_high", 63 0;
v0xb40bbe9bc9a0_0 .var "exp_period", 63 0;
E_0xb40bbe9681e0 .event posedge, v0xb40bbe9bceb0_0;
E_0xb40bbe93f7f0 .event negedge, v0xb40bbe9bceb0_0;
TD_tb_pll.check_period ;
    %wait E_0xb40bbe9681e0;
    %vpi_func 3 35 "$time" 64 {0 0 0};
    %store/vec4 v0xb40bbe9bd590_0, 0, 64;
    %wait E_0xb40bbe93f7f0;
    %vpi_func 3 36 "$time" 64 {0 0 0};
    %store/vec4 v0xb40bbe9bd410_0, 0, 64;
    %wait E_0xb40bbe9681e0;
    %vpi_func 3 37 "$time" 64 {0 0 0};
    %store/vec4 v0xb40bbe9bd4b0_0, 0, 64;
    %load/vec4 v0xb40bbe9bd4b0_0;
    %load/vec4 v0xb40bbe9bd590_0;
    %sub;
    %store/vec4 v0xb40bbe9bd190_0, 0, 64;
    %load/vec4 v0xb40bbe9bd410_0;
    %load/vec4 v0xb40bbe9bd590_0;
    %sub;
    %store/vec4 v0xb40bbe9bd0b0_0, 0, 64;
    %load/vec4 v0xb40bbe9bd190_0;
    %load/vec4 v0xb40bbe9bc9a0_0;
    %cmp/ne;
    %jmp/1 T_0.2, 6;
    %flag_mov 8, 6;
    %load/vec4 v0xb40bbe9bd0b0_0;
    %load/vec4 v0xb40bbe954290_0;
    %cmp/ne;
    %flag_or 6, 8;
T_0.2;
    %jmp/0xz  T_0.0, 6;
    %load/vec4 v0xb40bbe9bcfd0_0;
    %addi 1, 0, 32;
    %store/vec4 v0xb40bbe9bcfd0_0, 0, 32;
    %vpi_call/w 3 42 "$display", "FAIL  t=%0t  period=%0d ns (exp %0d), high=%0d ns (exp %0d)", $time, v0xb40bbe9bd190_0, v0xb40bbe9bc9a0_0, v0xb40bbe9bd0b0_0, v0xb40bbe954290_0 {0 0 0};
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0xb40bbe9bd190_0;
    %load/vec4 v0xb40bbe9bd0b0_0;
    %sub;
    %vpi_call/w 3 45 "$display", "PASS  t=%0t  period=%0d ns, high=%0d ns, low=%0d ns", $time, v0xb40bbe9bd190_0, v0xb40bbe9bd0b0_0, S<0,vec4,u64> {1 0 0};
T_0.1 ;
    %end;
S_0xb40bbe9bca80 .scope module, "dut" "pll" 3 22, 4 17 0, S_0xb40bbe92e690;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "sys_clk";
    .port_info 1 /INPUT 1 "sys_rst_n";
    .port_info 2 /OUTPUT 1 "vga_clk";
v0xb40bbe9bcd10_0 .net "sys_clk", 0 0, v0xb40bbe9bd250_0;  1 drivers
v0xb40bbe9bcdf0_0 .net "sys_rst_n", 0 0, v0xb40bbe9bd320_0;  1 drivers
v0xb40bbe9bceb0_0 .var "vga_clk", 0 0;
E_0xb40bbe92eeb0/0 .event negedge, v0xb40bbe9bcdf0_0;
E_0xb40bbe92eeb0/1 .event posedge, v0xb40bbe9bcd10_0;
E_0xb40bbe92eeb0 .event/or E_0xb40bbe92eeb0/0, E_0xb40bbe92eeb0/1;
    .scope S_0xb40bbe9bca80;
T_1 ;
    %wait E_0xb40bbe92eeb0;
    %load/vec4 v0xb40bbe9bcdf0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0xb40bbe9bceb0_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0xb40bbe9bceb0_0;
    %inv;
    %assign/vec4 v0xb40bbe9bceb0_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0xb40bbe92e690;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xb40bbe9bd250_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xb40bbe9bd320_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0xb40bbe9bcfd0_0, 0, 32;
    %end;
    .thread T_2, $init;
    .scope S_0xb40bbe92e690;
T_3 ;
    %delay 10, 0;
    %load/vec4 v0xb40bbe9bd250_0;
    %inv;
    %store/vec4 v0xb40bbe9bd250_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0xb40bbe92e690;
T_4 ;
    %vpi_call/w 3 52 "$dumpfile", "results/tb_pll.vcd" {0 0 0};
    %vpi_call/w 3 53 "$dumpvars", 32'sb00000000000000000000000000000000, S_0xb40bbe92e690 {0 0 0};
    %vpi_call/w 3 54 "$timeformat", 32'sb11111111111111111111111111110111, 32'sb00000000000000000000000000000000, " ns", 32'sb00000000000000000000000000001000 {0 0 0};
    %vpi_call/w 3 56 "$display", "=== Lab 3 pll (divide-by-2 pixel clock) test ===" {0 0 0};
    %delay 1, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xb40bbe9bd320_0, 0, 1;
    %delay 4, 0;
    %load/vec4 v0xb40bbe9bd670_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_4.0, 6;
    %load/vec4 v0xb40bbe9bcfd0_0;
    %addi 1, 0, 32;
    %store/vec4 v0xb40bbe9bcfd0_0, 0, 32;
    %vpi_call/w 3 63 "$display", "FAIL  t=%0t  vga_clk=%b during reset, expected 0", $time, v0xb40bbe9bd670_0 {0 0 0};
    %jmp T_4.1;
T_4.0 ;
    %vpi_call/w 3 65 "$display", "PASS  t=%0t  asynchronous reset holds vga_clk=0", $time {0 0 0};
T_4.1 ;
    %delay 60, 0;
    %load/vec4 v0xb40bbe9bd670_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_4.2, 6;
    %load/vec4 v0xb40bbe9bcfd0_0;
    %addi 1, 0, 32;
    %store/vec4 v0xb40bbe9bcfd0_0, 0, 32;
    %vpi_call/w 3 72 "$display", "FAIL  t=%0t  vga_clk=%b while reset is asserted", $time, v0xb40bbe9bd670_0 {0 0 0};
    %jmp T_4.3;
T_4.2 ;
    %vpi_call/w 3 74 "$display", "PASS  t=%0t  reset dominates the clock edges", $time {0 0 0};
T_4.3 ;
    %delay 35, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xb40bbe9bd320_0, 0, 1;
    %pushi/vec4 40, 0, 64;
    %store/vec4 v0xb40bbe9bc9a0_0, 0, 64;
    %pushi/vec4 20, 0, 64;
    %store/vec4 v0xb40bbe954290_0, 0, 64;
    %fork TD_tb_pll.check_period, S_0xb40bbe9584b0;
    %join;
    %pushi/vec4 40, 0, 64;
    %store/vec4 v0xb40bbe9bc9a0_0, 0, 64;
    %pushi/vec4 20, 0, 64;
    %store/vec4 v0xb40bbe954290_0, 0, 64;
    %fork TD_tb_pll.check_period, S_0xb40bbe9584b0;
    %join;
    %pushi/vec4 40, 0, 64;
    %store/vec4 v0xb40bbe9bc9a0_0, 0, 64;
    %pushi/vec4 20, 0, 64;
    %store/vec4 v0xb40bbe954290_0, 0, 64;
    %fork TD_tb_pll.check_period, S_0xb40bbe9584b0;
    %join;
    %delay 3, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xb40bbe9bd320_0, 0, 1;
    %delay 1, 0;
    %load/vec4 v0xb40bbe9bd670_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_4.4, 6;
    %load/vec4 v0xb40bbe9bcfd0_0;
    %addi 1, 0, 32;
    %store/vec4 v0xb40bbe9bcfd0_0, 0, 32;
    %vpi_call/w 3 89 "$display", "FAIL  t=%0t  second reset did not clear vga_clk", $time {0 0 0};
    %jmp T_4.5;
T_4.4 ;
    %vpi_call/w 3 91 "$display", "PASS  t=%0t  second asynchronous reset clears vga_clk", $time {0 0 0};
T_4.5 ;
    %delay 100, 0;
    %load/vec4 v0xb40bbe9bcfd0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_4.6, 4;
    %vpi_call/w 3 96 "$display", "RESULT: PASS (pll: 25 MHz, 50 %% duty, asynchronous reset)" {0 0 0};
    %jmp T_4.7;
T_4.6 ;
    %vpi_call/w 3 98 "$display", "RESULT: FAIL (%0d errors)", v0xb40bbe9bcfd0_0 {0 0 0};
T_4.7 ;
    %load/vec4 v0xb40bbe9bcfd0_0;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_4.8, 4;
    %vpi_call/w 3 100 "$fatal", 32'sb00000000000000000000000000000001, "tb_pll failed" {0 0 0};
T_4.8 ;
    %vpi_call/w 3 101 "$finish" {0 0 0};
    %end;
    .thread T_4;
